<!--views/index.ejs-->
<!DOCTYPE html>
<html>
  <head>
    <title>検索結果</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1>キーワード検索結果「<%= keyword %>」</h1>
    <% for(let i = 0; i < contents.length; i++) { %>
    <h3><%= contents[i].title %></h3>
    <p>投稿日：<%= contents[i].date.toISOString().slice(0, 10) %></p>
    <p><%= contents[i].detail %></p>
    <% } %>
    <form action="/" method="GET">
    <button type="submit">戻る</button>
    </form>
  </body>
</html>